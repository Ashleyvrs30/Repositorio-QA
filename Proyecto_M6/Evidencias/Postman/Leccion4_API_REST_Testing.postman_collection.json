	"item": [
		{
			"name": "Crear Usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// verificar código (acepta 200 o 201)\r",
							"pm.test(\"Status code is 200 or 201\", function () {\r",
							"    pm.expect([200, 201]).to.include(pm.response.code);\r",
							"});\r",
							"\r",
							"// comprobar que hay JSON y un id; guardarlo en entorno para PUT/DELETE\r",
							"pm.test(\"Response has id\", function () {\r",
							"    pm.expect(pm.response.text(), \"response is not empty\").to.not.be.empty;\r",
							"    let jsonData = {};\r",
							"    try { jsonData = pm.response.json(); } catch (e) { jsonData = {}; }\r",
							"    pm.expect(jsonData).to.have.property('id');\r",
							"    // guardar id en variable de entorno (siempre guardar en initial via script si querés que Newman lo use después)\r",
							"    pm.environment.set(\"userId\", jsonData.id);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"firstName\": \"Hugo\",\r\n  \"lastName\": \"Tester\",\r\n  \"age\": 30\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users/add",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"add"
					]
				}
			},
			"response": []
		},
		{
			"name": "Obtener Usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Body contains user data\", function () {\r",
							"    let jsonData = {};\r",
							"    try { jsonData = pm.response.json(); } catch (e) { jsonData = {}; }\r",
							"    // adapta estas propiedades según dummyjson (ej: id, firstName)\r",
							"    pm.expect(jsonData).to.have.property('id');\r",
							"    pm.expect(jsonData).to.have.property('firstName');\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/users/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"1"
					]
				}
			},
			"response": []
		},
		{
			"name": "Actualizar Usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response contains updated user data\", function () {\r",
							"    let jsonData = {};\r",
							"    try { jsonData = pm.response.json(); } catch (e) { jsonData = {}; }\r",
							"    pm.expect(jsonData).to.have.property('id');\r",
							"    // valida el campo que actualizaste (ej: lastName)\r",
							"    pm.expect(jsonData).to.have.property('lastName', 'QA_Actualizado');\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"lastName\": \"QA_Actualizado\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"1"
					]
				}
			},
			"response": []
		},
